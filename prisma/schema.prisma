generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Produit {
  id                   String  @id @default(cuid())
  reference            String  @unique
  designation          String
  categorie            String?
  unite                String? @default("u")
  quantiteParBoite     Int     @default(1)
  stockMinimum         Int     @default(0)
  prixUnitaire         Float?  @default(0.0)
  codeBarre            String? @unique
  referenceFournisseur String?
  fournisseur          String?
  retourAttendu        Boolean @default(false)

  stockInitial Int         @default(0)
  mouvements   Mouvement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id     String @id @default(cuid())
  nom    String @unique
  telephone String?
  email     String?
  typePeau  String?
  allergies String?
  notes     String?
  statut String @default("Actif")

  mouvements         Mouvement[]
  equipements          Equipement[]
  mouvementsEquipement MouvementEquipement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mouvement {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String
  quantite    Int
  utilisateur String?
  observation String?

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Equipement {
  id        String    @id @default(cuid())
  nom       String
  marque    String?
  reference String?   @unique
  dateAchat DateTime?
  valeur    Float?    @default(0.0)

  statut      String   @default("Disponible")
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id])
  utilisateur String?

  mouvements MouvementEquipement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MouvementEquipement {
  id          String   @id @default(cuid())
  equipementId  String
  equipement    Equipement @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  type        String
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id])
  utilisateur String
  date        DateTime @default(now())
  observation String?
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?
  role      String   @default("ESTHETICIENNE")
  createdAt DateTime @default(now())
}
